# Salin ke ~/.config/vidsub/config.env (Windows: %APPDATA%\vidsub\config.env) atau ./.env

# --- LLM (OpenAI-compatible: Ollama, OpenRouter, LM Studio, llama.cpp server, dll) ---
VIDSUB_LLM_URL=http://localhost:11434/v1
VIDSUB_LLM_MODEL=qwen2.5:7b-instruct
# VIDSUB_LLM_KEY=sk-...
# VIDSUB_LLM_TEMPERATURE=0.3
# VIDSUB_LLM_JSON_MODE=true
# VIDSUB_BATCH=25

# Contoh OpenRouter:
# VIDSUB_LLM_URL=https://openrouter.ai/api/v1
# VIDSUB_LLM_KEY=sk-or-...
# VIDSUB_LLM_MODEL=<nama-model>

# --- Speech-to-text ---
VIDSUB_ASR=local
VIDSUB_WHISPER_PYTHON=/home/USER/whisper-env/bin/python
# Windows: VIDSUB_WHISPER_PYTHON=C:\Users\USER\whisper-env\Scripts\python.exe
VIDSUB_WHISPER_MODEL=large-v3
VIDSUB_WHISPER_DEVICE=cpu
VIDSUB_WHISPER_COMPUTE=int8
# VIDSUB_WHISPER_THREADS=0

# Atau via API (Groq/OpenAI/speaches):
# VIDSUB_ASR=api
# VIDSUB_ASR_API_URL=https://api.groq.com/openai/v1
# VIDSUB_ASR_API_KEY=gsk_...
# VIDSUB_ASR_API_MODEL=whisper-large-v3

# --- Download ---
# VIDSUB_OUTPUT_DIR=~/Videos
