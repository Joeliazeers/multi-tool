{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MultiTool",
  "version": "0.2.0",
  "identifier": "id.multitool.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MultiTool",
        "width": 1140,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Download video, subtitle, QR code, and more",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "publisher": "MultiTool"
  }
}
